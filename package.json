{
  "name": "raidrelay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The first 90 seconds after a Twitch raid, designed. Codex x TwitchCon Hackathon 2026 entry.",
  "license": "MIT",
  "author": "Abhijeet Nardele",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --build",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:security": "tsx scripts/security-scan.ts",
    "test:claims": "tsx scripts/check-claims.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:security && pnpm test:claims",
    "dev": "tsx apps/server/src/index.ts",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
