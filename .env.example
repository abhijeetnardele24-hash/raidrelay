# RaidRelay Environment Configuration Template
# Copy to .env for local development: cp .env.example .env

PORT=4000
HOST=127.0.0.1
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000

# Session & Security Keys (Must be configured in production)
# Generate a secure 64-char hex key via: openssl rand -hex 32
SESSION_SECRET=
HMAC_VOTER_SALT=

# Database Configuration
DATABASE_PATH=./data/raidrelay.sqlite

# Twitch Developer Application Credentials (Optional for Demo Lab; required for live Twitch)
# Register at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback
TWITCH_BOT_USER_ID=

# EventSub WebSocket Gateway
TWITCH_EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
